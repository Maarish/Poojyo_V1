# ---------------------------------------------------------------------------
# POOJYO Ganpati 2026 — environment
# Copy to `.env.local` for local dev, and set the same keys in Vercel.
# EVERY key here is optional. With none of them set the site builds and runs
# from content/content.json with analytics disabled.
# ---------------------------------------------------------------------------

# Where content comes from: "json" (default, reads content/content.json)
# or "sheet" (fetches the published Google Sheet CSVs below).
# If "sheet" fails for ANY reason, the site silently falls back to the JSON.
CONTENT_SOURCE=json

# NOTE: the ISR window is NOT an env var — Next reads it statically. It lives in
# app/ganpati/page.tsx as `export const revalidate = 900`. Sheet edits appear
# only after that window elapses; they are not instant.

# ---------------------------------------------------------------------------
# Published Google Sheet CSV URLs — ONE PER TAB (each tab has its own gid).
# In Sheets: File -> Share -> Publish to web -> pick the tab -> CSV -> Publish.
# Paste the full published URL for each tab below.
# ---------------------------------------------------------------------------
SHEET_CSV_CONFIG=
SHEET_CSV_GARLANDS=
SHEET_CSV_PACKAGES=
SHEET_CSV_POOJA_ESSENTIALS=
SHEET_CSV_DECORATIONS=
SHEET_CSV_REVIEWS=
SHEET_CSV_MANDAL_BULK=

# Every key above is required once CONTENT_SOURCE=sheet — if any one of them
# fails, the site falls back to content/content.json wholesale.

# ---------------------------------------------------------------------------
# Analytics — both optional. Unset = track() is a no-op, no scripts loaded.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Canonical origin, used for metadata/OG/sitemap absolute URLs.
NEXT_PUBLIC_SITE_URL=https://poojyo.in
